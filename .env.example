# Local Compose defaults. For production use the exact HTTPS origin before registering.
RP_ID=localhost
ORIGIN=http://localhost:8080
RP_NAME=openGym
WEB_PORT=8080
SESSION_DAYS=90
# Bootstrap: protect access first, register the human owner, then configure the uid.
# Production: RP_ID=comespecialista.online ORIGIN=https://comespecialista.online
ADMIN_UIDS=
INVITE_ONLY=0
# Never mount the upstream data directory; use a NEW empty persistent volume.
